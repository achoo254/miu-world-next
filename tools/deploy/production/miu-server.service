[Unit]
Description=Miu World API (production)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
User=miu
Group=miu
# NODE_ENV, PORT (8797: 8787 is taken on .65), DATABASE_URL, ALLOWED_ORIGINS, OIDC_*: written by
# deploy.sh setup (OIDC_* also by deploy.sh signin), never in the repo.
EnvironmentFile=/etc/miu/production.env
# IPv6 egress on .65 is broken and IPv4 connects can take over 2 s, so Node's default happy eyeballs (250 ms per
# address) times out on outbound calls: try IPv4 first and give each address 2.5 s.
Environment="NODE_OPTIONS=--dns-result-order=ipv4first --network-family-autoselection-attempt-timeout=2500"
# Own journal with a 14-day retention (journald-miu.conf); logs carry ids only, never email or names.
LogNamespace=miu
WorkingDirectory=/opt/miu/current
ExecStart=/opt/node22/bin/node --enable-source-maps /opt/miu/current/apps/server/dist/server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
